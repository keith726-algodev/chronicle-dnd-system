# Only the exact string "false" turns demo mode off. Unset or any other
# value keeps the app on the simulated localStorage backend.
VITE_USE_MOCK_API=true

# Required once VITE_USE_MOCK_API=false. Your deployed API's public URL,
# no trailing slash. Example: https://chronicle-api.onrender.com
VITE_API_BASE_URL=http://localhost:3000
