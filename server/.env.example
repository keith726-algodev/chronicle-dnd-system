# PostgreSQL connection string. Contains a password — never commit the real
# value. Local docker example:
DATABASE_URL=postgresql://postgres:isummonchronicle@localhost:5432/chronicle

# Comma-separated list of origins allowed to call this API. An origin has
# no path and no trailing slash.
# Example: CORS_ORIGINS=http://localhost:5173,https://yourusername.github.io
CORS_ORIGINS=http://localhost:5173

# Set to "production" on your host. Leave unset locally.
NODE_ENV=development

# Do NOT set this yourself in production — your host injects its own PORT.
PORT=3000
