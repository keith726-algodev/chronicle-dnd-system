# Used by compose.yml only, if you self-host the API + database together
# instead of using separate managed hosts. client/.env.example and
# server/.env.example are the ones that matter for everyday development —
# this file just lets `docker compose` read the same values from one place.

POSTGRES_DB=chronicle
POSTGRES_PASSWORD=isummonchronicle
DATABASE_URL=postgresql://postgres:devpassword@db:5432/chronicle
CORS_ORIGINS=http://localhost:5173
PORT=3000
